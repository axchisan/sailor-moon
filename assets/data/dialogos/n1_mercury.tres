[ext_resource type="AudioStream" path="res://assets/audio/voces/n1_mercury/mercury_07.mp3" id="a13"]
[ext_resource type="AudioStream" path="res://assets/audio/voces/n1_mercury/serena_04.mp3" id="a14"]
[ext_resource type="AudioStream" path="res://assets/audio/voces/n1_mercury/luna_05.mp3" id="a15"]

[sub_resource type="Resource" id="L00"]
script = ExtResource("2_linea")
hablante = "luna"
texto = "¡Serena, espera! Hay alguien detrás de esos árboles…"
emocion = "[whispering]"
audio = ExtResource("a0")
pausa_final = 0.3
velocidad = 42.0

[sub_resource type="Resource" id="L01"]
script = ExtResource("2_linea")
hablante = "serena"
texto = "¿Otra criatura? ¡Ya verás lo que le espera!"
emocion = "[excited]"
audio = ExtResource("a1")
pausa_final = 0.25
velocidad = 42.0

[sub_resource type="Resource" id="L02"]
script = ExtResource("2_linea")
hablante = "luna"
texto = "No, tonta. Esa energía es distinta. Es… nuestra."
emocion = "[soft]"
audio = ExtResource("a2")
pausa_final = 0.4
velocidad = 42.0

[sub_resource type="Resource" id="L03"]
script = ExtResource("2_linea")
hablante = "mercury"
texto = "¿Ho-hola? ¿Hay alguien ahí?"
emocion = "[breathy]"
audio = ExtResource("a3")
pausa_final = 0.35
velocidad = 42.0

[sub_resource type="Resource" id="L04"]
script = ExtResource("2_linea")
hablante = "serena"
texto = "¡Amy! ¿Qué haces aquí sola?"
emocion = ""
audio = ExtResource("a4")
pausa_final = 0.25
velocidad = 42.0

[sub_resource type="Resource" id="L05"]
script = ExtResource("2_linea")
hablante = "mercury"
texto = "Serena… menos mal que eres tú. Salí a estudiar al parque y de pronto todo se puso oscuro."
emocion = "[embarrassed]"
audio = ExtResource("a5")
pausa_final = 0.4
velocidad = 42.0

[sub_resource type="Resource" id="L06"]
script = ExtResource("2_linea")
hablante = "mercury"
texto = "Los peluches de la feria se levantaron solos. Me escondí aquí y no me atrevía a salir."
emocion = "[sad]"
audio = ExtResource("a6")
pausa_final = 0.45
velocidad = 42.0

[sub_resource type="Resource" id="L07"]
script = ExtResource("2_linea")
hablante = "luna"
texto = "Amy, escúchame bien. Eso que sientes en el pecho no es miedo. Es tu poder despertando."
emocion = "[emphasis]"
audio = ExtResource("a7")
pausa_final = 0.5
velocidad = 42.0

[sub_resource type="Resource" id="L08"]
script = ExtResource("2_linea")
hablante = "mercury"
texto = "¿Mi… poder? Pero si yo solo sé resolver ecuaciones."
emocion = ""
audio = ExtResource("a8")
pausa_final = 0.3
velocidad = 42.0

[sub_resource type="Resource" id="L09"]
script = ExtResource("2_linea")
hablante = "serena"
texto = "¡Eso es justo lo que nos hace falta! Yo pego fuerte, pero pensar se me da fatal."
emocion = "[excited]"
audio = ExtResource("a9")
pausa_final = 0.35
velocidad = 42.0

[sub_resource type="Resource" id="L10"]
script = ExtResource("2_linea")
hablante = "mercury"
texto = "Eso sí es verdad."
emocion = "[chuckling]"
audio = ExtResource("a10")
pausa_final = 0.3
velocidad = 42.0

[sub_resource type="Resource" id="L11"]
script = ExtResource("2_linea")
hablante = "luna"
texto = "Di las palabras, Amy. Ya las conoces, aunque no sepas de dónde."
emocion = "[emphasis]"
audio = ExtResource("a11")
pausa_final = 0.45
velocidad = 42.0

[sub_resource type="Resource" id="L12"]
script = ExtResource("2_linea")
hablante = "mercury"
texto = "¡Por el poder estelar del planeta Mercurio… transformación!"
emocion = "[excited]"
audio = ExtResource("a12")
pausa_final = 0.6
velocidad = 42.0

[sub_resource type="Resource" id="L13"]
script = ExtResource("2_linea")
hablante = "mercury"
texto = "…Serena. Puedo verlo todo. Dónde están, cuántos son, por dónde vienen."
emocion = "[soft]"
audio = ExtResource("a13")
pausa_final = 0.4
velocidad = 42.0

[sub_resource type="Resource" id="L14"]
script = ExtResource("2_linea")
hablante = "serena"
texto = "¡Sailor Mercury! ¡Ahora sí que estamos completas!"
emocion = "[excited]"
audio = ExtResource("a14")
pausa_final = 0.3
velocidad = 42.0

[sub_resource type="Resource" id="L15"]
script = ExtResource("2_linea")
hablante = "luna"
texto = "Completas no. Pero un poco menos solas. Vamos, queda camino."
emocion = "[soft]"
audio = ExtResource("a15")
pausa_final = 0.4
velocidad = 42.0

[resource]
script = ExtResource("1_dialogo")
id = "n1_mercury"
lineas = Array[ExtResource("2_linea")]([SubResource("L00"), SubResource("L01"), SubResource("L02"), SubResource("L03"), SubResource("L04"), SubResource("L05"), SubResource("L06"), SubResource("L07"), SubResource("L08"), SubResource("L09"), SubResource("L10"), SubResource("L11"), SubResource("L12"), SubResource("L13"), SubResource("L14"), SubResource("L15")])
desbloquea = "sailor_mercury"
mensaje_final = "¡Sailor Mercury se une!"
