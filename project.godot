; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sailor Moon: El Cristal de los Suenos"
config/description="Aventura de accion 3D. Proyecto personal, no comercial."
run/main_scene="res://scenes/prototypes/test_movement.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://src/autoload/event_bus.gd"
AudioManager="*res://src/autoload/audio_manager.gd"
GameManager="*res://src/autoload/game_manager.gd"
SaveManager="*res://src/autoload/save_manager.gd"
SceneLoader="*res://src/autoload/scene_loader.gd"
Settings="*res://src/autoload/settings.gd"
CombatFeel="*res://src/autoload/combat_feel.gd"
McpInteractionServer="*res://scripts/mcp_interaction_server.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

